<Window x:Class="DesktopWorkflow.App.ApplicationPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加应用" Icon="Assets/desktop-workflow.ico"
        Width="920" Height="660" MinWidth="820" MinHeight="540"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- 候选卡片列表项样式（多选复选框 + 真实图标） -->
        <Style x:Key="CandidateListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 多选复选框指示器 -->
                                <Border x:Name="checkSquareOuter" Width="18" Height="18" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Background="#FFFFFF" VerticalAlignment="Center">
                                    <Path x:Name="checkMarkInner" Data="M 2 5 L 6 9 L 12 3" Stroke="#FFFFFF" StrokeThickness="2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <!-- 真实窗口/应用图标 -->
                                <Image Grid.Column="1" Source="{Binding Icon}" Width="24" Height="24"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- 标题与详情 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <!-- 选中指示勾 -->
                                <Path x:Name="checkMarkRight" Grid.Column="3" Data="M 2 6 L 6 10 L 14 2"
                                      Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                      VerticalAlignment="Center" Margin="12,0,4,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.75" />
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="checkSquareOuter" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="checkSquareOuter" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="checkMarkInner" Property="Visibility" Value="Visible" />
                                <Setter TargetName="checkMarkRight" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题与搜索框 -->
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="添加应用" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="优先选择当前已打开的窗口；也可从安装列表或文件添加。" Margin="0,4,0,12"
                       Foreground="{StaticResource MutedBrush}" FontSize="13" />
            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged"
                     ToolTip="搜索窗口、进程或标题..." Margin="0,0,0,4" />
        </StackPanel>

        <!-- 来源分段选项卡 -->
        <TabControl x:Name="SourceTabs" Grid.Row="1" SelectionChanged="SourceTabs_SelectionChanged">
            <TabItem Header="当前窗口">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <CheckBox x:Name="SystemWindowsCheckBox" Content="显示系统窗口"
                                  Checked="RefreshCurrentButton_Click" Unchecked="RefreshCurrentButton_Click" />
                        <Button DockPanel.Dock="Right" Content="刷新" Click="RefreshCurrentButton_Click" Margin="0" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="310" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="CurrentListBox" Background="Transparent" BorderThickness="0"
                                 SelectionMode="Multiple"
                                 ItemContainerStyle="{StaticResource CandidateListBoxItemStyle}"
                                 SelectionChanged="CandidateListBox_SelectionChanged"
                                 MouseDoubleClick="CandidateListBox_MouseDoubleClick" />

                        <!-- 右侧当前窗口画面预览卡片 -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="窗口预览" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <!-- 预览图像容器 -->
                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="CurrentWindowPreviewImage" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel x:Name="CurrentWindowPreviewPlaceholder" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" Margin="16">
                                            <Border Width="36" Height="36" CornerRadius="18" Background="#EEF2F6"
                                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <Path Data="M 10 12 L 26 12 L 26 24 L 10 24 Z M 13 21 L 17 16 L 20 19 L 23 15 L 25 21 Z"
                                                      Fill="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="CurrentWindowPreviewPlaceholderText"
                                                       Text="点选左侧窗口查看预览"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 底部信息 -->
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <TextBlock x:Name="CurrentWindowPreviewTitle" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CurrentWindowPreviewMeta" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="已安装应用">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="InstalledLoadingText" Text="正在读取开始菜单和注册信息……"
                               Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}" />
                    <ListBox x:Name="InstalledListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionMode="Multiple"
                             ItemContainerStyle="{StaticResource CandidateListBoxItemStyle}"
                             SelectionChanged="CandidateListBox_SelectionChanged"
                             MouseDoubleClick="CandidateListBox_MouseDoubleClick" />
                </Grid>
            </TabItem>

            <TabItem Header="选择文件">
                <StackPanel Margin="18">
                    <Button Content="选择 EXE 或快捷方式..." HorizontalAlignment="Left" Click="ChooseFileButton_Click" />
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="FileNameText" Text="尚未选择文件" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="FileDetailText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 底部提示与操作 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="选择后将生成窗口目标；标题与进程匹配规则可在该应用的高级设置中检查。"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelButton_Click" />
                <Button x:Name="AddButton" Content="添加" Style="{StaticResource PrimaryButton}" Click="AddButton_Click" Margin="0" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
