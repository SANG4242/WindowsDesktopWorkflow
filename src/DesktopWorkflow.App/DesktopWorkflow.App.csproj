<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DesktopWorkflow</AssemblyName>
    <RootNamespace>DesktopWorkflow.App</RootNamespace>
    <ApplicationIcon>Assets\desktop-workflow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\desktop-workflow.ico" />
    <None Update="Assets\desktop-workflow.png" />
    <InternalsVisibleTo Include="DesktopWorkflow.Tests" />
  </ItemGroup>
</Project>
