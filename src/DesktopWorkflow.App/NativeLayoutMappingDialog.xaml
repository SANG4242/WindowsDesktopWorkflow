<Window x:Class="DesktopWorkflow.App.NativeLayoutMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义 Win+Z 数字" Icon="Assets/desktop-workflow.ico"
        Width="620" Height="590" MinWidth="540" MinHeight="500"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="当前显示环境的 Win+Z 数字" FontSize="24" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="只填写下方六种固定布局在 Win+Z 菜单中的数字。顶部带应用图标的动态建议不属于固定布局。修改后，受影响布局会重新进入待验证状态。" />
        </StackPanel>
        <DataGrid x:Name="MappingsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="固定布局" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="默认数字" Binding="{Binding DefaultMenuNumber}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="当前数字" Binding="{Binding MenuNumber, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="110" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#9A2727" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="恢复默认 4–9" Click="ResetButton_Click" />
                <Button Content="取消" Click="CancelButton_Click" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Margin="0" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
