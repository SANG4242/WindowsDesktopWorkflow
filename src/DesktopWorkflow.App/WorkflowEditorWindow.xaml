<Window x:Class="DesktopWorkflow.App.WorkflowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopWorkflow.App"
        Title="工作流编辑器" Icon="Assets/desktop-workflow.ico"
        Width="1020" Height="740" MinWidth="860" MinHeight="600"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed" Closing="Window_Closing">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部返回导航与保存状态 -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Padding="4,4,8,4" Click="CancelButton_Click" ToolTip="返回">
                    <TextBlock Text="←" FontSize="16" FontWeight="Bold" />
                </Button>
                <TextBlock x:Name="EditorTitleText" Text="编辑工作流" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center">
                <TextBlock x:Name="DraftStatusBadgeText" Text="草稿" FontSize="11.5" FontWeight="Medium"
                           Foreground="{StaticResource MutedBrush}" />
            </Border>
        </Grid>

        <!-- 主体双栏区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.85*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：可滚动的连续配置流 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <!-- 分区 1：基本信息与标识备注 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="基本信息" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="工作流名称" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <TextBox x:Name="NameTextBox" TextChanged="NameTextBox_TextChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="工作流 ID (唯一标识)" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <TextBox x:Name="IdTextBox" TextChanged="IdTextBox_TextChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="备注说明 (可选)" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                            <TextBox x:Name="DescriptionTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                     TextChanged="DescriptionTextBox_TextChanged" />
                        </StackPanel>
                    </Border>

                    <!-- 分区 2：选择应用 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="选择应用" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="添加参与本工作流排列的窗口目标，可排序或配置详细规则。"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />

                            <!-- 应用卡片堆叠列表 -->
                            <ItemsControl x:Name="TargetsListBox">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MatchSummary}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="↑" Padding="8,4" Margin="0,0,4,0" Tag="{Binding}"
                                                            Click="MoveUpTargetButton_Click" ToolTip="上移" />
                                                    <Button Content="↓" Padding="8,4" Margin="0,0,6,0" Tag="{Binding}"
                                                            Click="MoveDownTargetButton_Click" ToolTip="下移" />
                                                    <Button Content="参数与设置" Padding="10,4" Margin="0,0,6,0" Tag="{Binding}"
                                                            Click="EditTargetItemButton_Click" ToolTip="启动参数、工作目录与高级窗口匹配规则" />
                                                    <Button Content="删除" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0" Tag="{Binding}"
                                                            Click="RemoveTargetItemButton_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 添加应用主入口按钮 -->
                            <Button Content="+ 添加应用" Style="{StaticResource GhostButton}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    HorizontalAlignment="Stretch" Padding="0,10" Margin="0,4,0,0"
                                    Click="AddApplicationButton_Click" />
                        </StackPanel>
                    </Border>

                    <!-- 分区 3：布局与区域 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="布局与区域" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <!-- 模式单选切换 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton x:Name="NativeModeRadio" Content="Windows 原生贴靠" IsChecked="True"
                                             Checked="LayoutMode_Changed" Margin="0,0,18,0" />
                                <RadioButton x:Name="ProportionalModeRadio" Content="自定义比例"
                                             Checked="LayoutMode_Changed" Margin="0" />
                            </StackPanel>

                            <!-- 原生贴靠选项 -->
                            <StackPanel x:Name="NativeOptionsPanel">
                                <TextBlock Text="原生贴靠布局" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="校准数字" Margin="10,0,0,0"
                                            Click="ConfigureNativeLayoutsButton_Click" />
                                    <ComboBox x:Name="NativeLayoutComboBox" DisplayMemberPath="DisplayName"
                                              SelectionChanged="NativeLayoutComboBox_SelectionChanged" />
                                </DockPanel>
                            </StackPanel>

                            <!-- 比例布局选项 -->
                            <StackPanel x:Name="ProportionalOptionsPanel" Visibility="Collapsed">
                                <TextBlock Text="排列方向" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <ComboBox x:Name="OrientationComboBox" Margin="0,0,0,12" SelectedValuePath="Tag"
                                          SelectionChanged="LayoutControl_Changed">
                                    <ComboBoxItem Content="左右排列" Tag="horizontal" />
                                    <ComboBoxItem Content="上下排列" Tag="vertical" />
                                </ComboBox>
                                <TextBlock Text="窗口比例 (英文逗号分隔，如 2,1)" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox x:Name="RatiosTextBox" Margin="0,0,0,14" TextChanged="RatiosTextBox_TextChanged" />
                            </StackPanel>

                            <!-- 区域分配列表 -->
                            <TextBlock Text="区域指派" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,8" />
                            <ItemsControl x:Name="AssignmentItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="2,8" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="200" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ZoneLabel}" VerticalAlignment="Center"
                                                           FontSize="13" Foreground="{StaticResource TextBrush}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding TargetOptions}"
                                                          DisplayMemberPath="Name"
                                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                          SelectionChanged="AssignmentComboBox_SelectionChanged" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 分区 4：快速启动 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="快速启动" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock x:Name="HotkeyHintText" Text="点击「录入快捷键」后直接按下按键组合；录入完成后点击「完成保存」。"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HotkeyTextBox" IsReadOnly="True"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button x:Name="RecordHotkeyButton" Content="录入快捷键" Padding="14,7" Click="RecordHotkeyButton_Click" />
                                    <Button x:Name="ClearHotkeyButton" Content="清空" Style="{StaticResource GhostButton}" Padding="10,7" Margin="0" Click="ClearHotkeyButton_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右栏：实时预览看板与提交动作 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 预览标题与线框 -->
                    <StackPanel>
                        <TextBlock Text="实时预览" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreviewSubtitleText" Text="Windows 原生贴靠 · 左宽右窄"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" />
                    </StackPanel>

                    <local:LayoutPreviewControl x:Name="LayoutPreview" Grid.Row="1" MinHeight="220" Margin="0,0,0,14" />

                    <!-- 指标统计与校验胶囊 -->
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WindowCountText" Text="窗口数：2" FontSize="13" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="ZoneCountText" Grid.Column="1" Text="布局区域：2" FontSize="13" Foreground="{StaticResource TextBrush}" />
                        </Grid>

                        <Border x:Name="ValidationBadge" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Margin="0,0,0,14">
                            <TextBlock x:Name="ValidationBadgeText" Text="● 配置结构正常" FontSize="12"
                                       Foreground="#16A34A" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- 状态信息 -->
                    <TextBlock x:Name="EditorStatusText" Grid.Row="3" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <!-- 底部保存/取消操作 -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="取消" HorizontalAlignment="Left" Padding="18,8" Click="CancelButton_Click" />
                        <Button x:Name="EditorSaveButton" Grid.Column="1" Content="保存工作流" Style="{StaticResource PrimaryButton}"
                                Padding="24,9" Click="SaveButton_Click" Margin="0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
