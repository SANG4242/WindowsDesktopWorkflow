<Window x:Class="DesktopWorkflow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopWorkflow.App"
        Title="桌面工作流" Icon="Assets/desktop-workflow.ico"
        Width="920" Height="680" MinWidth="800" MinHeight="560"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        Closing="Window_Closing">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部导航条 -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/desktop-workflow.ico" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="桌面工作流" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="10,6" Margin="0"
                    Click="SettingsButton_Click" ToolTip="全局设置与日志">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 7.5 4.5 C 5.84 4.5 4.5 5.84 4.5 7.5 C 4.5 9.16 5.84 10.5 7.5 10.5 C 9.16 10.5 10.5 9.16 10.5 7.5 C 10.5 5.84 9.16 4.5 7.5 4.5 Z M 13.72 6.67 C 13.78 6.94 13.82 7.21 13.82 7.5 C 13.82 7.79 13.78 8.06 13.72 8.33 L 15.24 9.52 C 15.38 9.63 15.42 9.82 15.33 9.98 L 13.89 12.48 C 13.8 12.64 13.61 12.7 13.44 12.64 L 11.65 11.92 C 11.28 12.2 10.87 12.44 10.43 12.62 L 10.16 14.53 C 10.13 14.71 9.98 14.85 9.79 14.85 L 6.91 14.85 C 6.72 14.85 6.57 14.71 6.54 14.53 L 6.27 12.62 C 5.83 12.44 5.42 12.2 5.05 11.92 L 3.26 12.64 C 3.09 12.7 2.9 12.64 2.81 12.48 L 1.37 9.98 C 1.28 9.82 1.32 9.63 1.46 9.52 L 2.98 8.33 C 2.92 8.06 2.88 7.79 2.88 7.5 C 2.88 7.21 2.92 6.94 2.98 6.67 L 1.46 5.48 C 1.32 5.37 1.28 5.18 1.37 5.02 L 2.81 2.52 C 2.9 2.36 3.09 2.3 3.26 2.36 L 5.05 3.08 C 5.42 2.8 5.83 2.56 6.27 2.38 L 6.54 0.47 C 6.57 0.29 6.72 0.15 6.91 0.15 L 9.79 0.15 C 9.98 0.15 10.13 0.29 10.16 0.47 L 10.43 2.38 C 10.87 2.56 11.28 2.8 11.65 3.08 L 13.44 2.36 C 13.61 2.3 13.8 2.36 13.89 2.52 L 15.33 5.02 C 15.42 5.18 15.38 5.37 15.24 5.48 L 13.72 6.67 Z"
                          Fill="{StaticResource MutedBrush}" Width="13" Height="13" Stretch="Uniform"
                          Margin="0,0,6,0" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                    <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="SettingsMenu">
                        <MenuItem x:Name="AutoStartMenuItem" Header="开机启动托盘" IsCheckable="True" StaysOpenOnClick="True" Click="AutoStartMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="导入工作流..." Click="ImportWorkflowButton_Click" />
                        <MenuItem Header="查看运行日志" Click="LogButton_Click" />
                        <MenuItem Header="打开数据目录" Click="OpenDataDirMenuItem_Click" />
                        <MenuItem Header="重新加载工作流" Click="ReloadButton_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- 主体 Master-Detail 区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：我的工作流列表 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="我的工作流" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Button Grid.Row="1" Content="+ 新建工作流" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,14" Padding="0,9"
                        Click="NewWorkflowButton_Click" />

                <ListBox x:Name="WorkflowListBox" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         Padding="2,2,4,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="WorkflowListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#CBD5E1" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="itemBorder" Property="Background" Value="#F8FAFC" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 右栏：工作流详情看板 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="24">
                <Grid>
                    <!-- 空状态展示 -->
                    <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="尚未创建任何工作流" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="点击左侧「+ 新建工作流」快速创建你的首个桌面工作流。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,16" HorizontalAlignment="Center" />
                        <Button Content="创建第一个工作流" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                                Click="NewWorkflowButton_Click" Padding="18,8" />
                    </StackPanel>

                    <!-- 选中工作流详情内容 -->
                    <Grid x:Name="DetailsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 头部标题与徽章 -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedTitleText" Text="工作流名称" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Badge}" Margin="12,0,0,0">
                                    <TextBlock x:Name="StatusBadgeText" Text="可执行" FontSize="11.5" FontWeight="Medium"
                                               Foreground="{StaticResource PrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SelectedSubtitleText" Text="代码编辑器 · 文档浏览器 | Windows 原生贴靠"
                                       Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 中部：工作区预览 -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="工作区预览" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <local:LayoutPreviewControl x:Name="LayoutPreview" Grid.Row="1" />
                        </Grid>

                        <!-- 底部：快捷键信息与操作主动作条 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedHotkeyText" Text="快捷键 Ctrl + Alt + 1" FontSize="13"
                                           FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}"
                                        Content="执行排列" Padding="24,9" FontSize="13.5"
                                        Click="RunButton_Click" />
                                <Button x:Name="EditWorkflowButton" Content="编辑" Padding="16,8"
                                        Click="EditWorkflowButton_Click" />
                                <Button x:Name="MoreButton" Content="更多 ···" Padding="14,8" Margin="0"
                                        Click="MoreButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="WorkflowContextMenu">
                                            <MenuItem Header="复制工作流" Click="CopyWorkflowButton_Click" />
                                            <MenuItem Header="导出工作流..." Click="ExportWorkflowButton_Click" />
                                            <Separator />
                                            <MenuItem Style="{StaticResource DangerMenuItem}" Header="删除工作流"
                                                      Click="DeleteWorkflowButton_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 诊断通知栏浮动条 -->
                    <Border x:Name="DiagnosticBanner" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" VerticalAlignment="Top" Margin="0,0,0,0"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="查看详情" Click="DiagnosticsButton_Click" Margin="10,0,0,0" />
                            <TextBlock x:Name="DiagnosticText" VerticalAlignment="Center" Foreground="#B45309"
                                       FontSize="12.5" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
