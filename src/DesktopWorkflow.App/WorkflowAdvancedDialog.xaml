<Window x:Class="DesktopWorkflow.App.WorkflowAdvancedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作流高级设置" Icon="Assets/desktop-workflow.ico"
        Width="520" Height="400" MinWidth="440" MinHeight="340"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="工作流高级设置" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="配置工作流唯一标识符与补充描述说明。"
                       Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="工作流 ID (英文、数字及中划线)" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
            <TextBox x:Name="IdTextBox" Margin="0,0,0,16" />

            <TextBlock Text="描述说明 (可选)" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
            <TextBox x:Name="DescriptionTextBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelButton_Click" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Margin="0" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
