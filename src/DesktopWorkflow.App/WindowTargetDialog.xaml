<Window x:Class="DesktopWorkflow.App.WindowTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用设置" Icon="Assets/desktop-workflow.ico"
        Width="680" Height="680" MinWidth="600" MinHeight="560"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="应用与窗口目标" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="SourceText" Margin="0,5,0,16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="显示名称" FontWeight="SemiBold" />
                <TextBox x:Name="NameTextBox" Margin="0,6,0,12" />
                <TextBlock Text="启动目标" FontWeight="SemiBold" />
                <TextBox x:Name="ExeTextBox" Margin="0,6,0,12" />
                <TextBlock Text="启动参数" FontWeight="SemiBold" />
                <TextBox x:Name="ArgumentsTextBox" Margin="0,6,0,12" />
                <TextBlock Text="工作目录" FontWeight="SemiBold" />
                <TextBox x:Name="WorkingDirectoryTextBox" Margin="0,6,0,18" />
                <Expander Header="高级设置" IsExpanded="True">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="进程文件名" FontWeight="SemiBold" />
                        <TextBox x:Name="ProcessNameTextBox" Margin="0,6,0,12" />
                        <TextBlock Text="窗口标题包含" FontWeight="SemiBold" />
                        <TextBox x:Name="TitlesTextBox" Margin="0,6,0,4" />
                        <TextBlock Text="多个候选使用 | 分隔。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="进程命令行包含" FontWeight="SemiBold" />
                        <TextBox x:Name="ProcessArgumentsTextBox" Margin="0,6,0,12" />
                        <DockPanel>
                            <CheckBox x:Name="ReuseCheckBox" Content="优先复用已有窗口" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="等待秒数" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="WaitSecondsTextBox" Width="72" />
                            </StackPanel>
                        </DockPanel>
                        <Button Content="测试匹配" HorizontalAlignment="Left" Margin="0,14,0,0" Click="TestMatchButton_Click" />
                        <TextBlock x:Name="MatchResultText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="CancelButton_Click" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Margin="0" />
        </WrapPanel>
    </Grid>
</Window>
